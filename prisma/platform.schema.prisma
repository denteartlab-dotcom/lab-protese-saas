generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/platform-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Laboratorio {
  id        String   @id @default(cuid())
  nome      String
  dbPath    String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  whatsapp      String?     @unique
  password      String
  role          String      @default("admin")
  laboratorioId String
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model VerificacaoWhatsapp {
  id         String   @id @default(cuid())
  whatsapp   String
  codigoHash String
  expiresAt  DateTime
  enviadoEm  DateTime @default(now())
  tentativas Int      @default(0)

  @@index([whatsapp])
}

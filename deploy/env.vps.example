# .env para VPS Linux local — multi-empresa (Fase 6)
# Copie: cp deploy/env.vps.example .env

# --- Postgres no próprio VPS ---
DATABASE_URL="postgresql://labprotese:SENHA@127.0.0.1:5432/labprotese?schema=public"
DIRECT_URL="postgresql://labprotese:SENHA@127.0.0.1:5432/labprotese?schema=public"

# --- Sessão (obrigatório) ---
JWT_SECRET="gere-com-openssl-rand-base64-32"

# --- URL pública (IP ou domínio) ---
# Sem SSL: use http://SEU_IP:3000 e COOKIE_SECURE=false
NEXT_PUBLIC_APP_URL="http://192.168.1.100:3000"
URL_PUBLICA_DO_APP="http://192.168.1.100:3000"
COOKIE_SECURE=false

# --- Servidor ---
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# --- Multi-empresa (migração) ---
EMPRESA_SLUG_PADRAO=denteart
EMPRESA_NOME_PADRAO=DenteArt

# --- Backup automático ---
BACKUP_AUTOMATICO_ENABLED=true
# Caminho absoluto recomendado no Linux:
# BACKUP_AUTOMATICO_PATH=/var/backups/lab-protese
BACKUP_AUTOMATICO_TZ=America/Sao_Paulo

# --- Uploads (recomendado no VPS) ---
UPLOAD_STORAGE=database

# --- App ---
NEXT_PUBLIC_APP_NAME="Lab Prótese"

# --- Validação pós-deploy (opcional) ---
# VPS_CHECK_URL=http://127.0.0.1:3000

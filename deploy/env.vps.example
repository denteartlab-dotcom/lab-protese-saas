# .env para VPS Linux local — multi-empresa (Fase 6)
# Copie: cp deploy/env.vps.example .env

# --- Postgres no próprio VPS ---
DATABASE_URL="postgresql://labprotese:SENHA@127.0.0.1:5432/labprotese?schema=public"
DIRECT_URL="postgresql://labprotese:SENHA@127.0.0.1:5432/labprotese?schema=public"

# --- Sessão (obrigatório) ---
JWT_SECRET="gere-com-openssl-rand-base64-32"
# Segredo separado do painel master (recomendado). Fallback: JWT_SECRET.
MASTER_JWT_SECRET="gere-com-openssl-rand-base64-32-diferente"
# Criptografia dos secrets MFA (opcional; fallback JWT_SECRET)
# MFA_ENCRYPTION_KEY="gere-com-openssl-rand-base64-32"
# Após esta data, MFA não pode mais ser pulado (master + proprietário)
# MFA_ENFORCE_AFTER=2026-08-20T00:00:00.000Z

# --- URL pública (domínio real — NUNCA 0.0.0.0) ---
NEXT_PUBLIC_APP_URL="https://www.denteartlab.com.br"
URL_PUBLICA_DO_APP="https://www.denteartlab.com.br"
COOKIE_SECURE=true

# --- Servidor ---
NODE_ENV=production
PORT=3000
# Bind em todas as interfaces. NÃO copie isso para NEXT_PUBLIC_APP_URL.
HOSTNAME=0.0.0.0
EMPRESA_SLUG_PADRAO=denteart
EMPRESA_NOME_PADRAO=DenteArt

# --- Backup automático ---
BACKUP_AUTOMATICO_ENABLED=true
# Caminho absoluto recomendado no Linux:
# BACKUP_AUTOMATICO_PATH=/var/backups/lab-protese
BACKUP_AUTOMATICO_TZ=America/Sao_Paulo

# --- Google Drive (uploads + backup) — OAuth, conta Google sem Workspace ---
# Guia completo: deploy/GOOGLE-DRIVE-UPLOADS.md
# 1) Ative Drive API + OAuth Desktop no Google Cloud
# 2) Crie pasta no Meu Drive e copie o Folder ID
# 3) npm run uploads:gdrive-token  → GOOGLE_DRIVE_REFRESH_TOKEN
UPLOAD_STORAGE=gdrive
GOOGLE_DRIVE_BACKUP_ENABLED=true
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ROOT_FOLDER_NAME=Lab_Protese_Backups
# Service account só com Shared Drive (Workspace). OAuth tem prioridade.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/lab-protese/gdrive-service-account.json

# --- App ---
NEXT_PUBLIC_APP_NAME="Lab Prótese"

# --- Assinatura SaaS — PIX Mercado Pago (recomendado) ---
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Guia completo: deploy/MERCADOPAGO-ASSINATURA.md
MP_PLATAFORMA_ACCESS_TOKEN=
MP_PLATAFORMA_AMBIENTE=producao
# Secret do webhook (evento Pagamentos) — ver deploy/MERCADOPAGO-ASSINATURA.md
MP_PLATAFORMA_WEBHOOK_SECRET=
# Alternativa se MP não configurado:
# ASAAS_PLATAFORMA_API_KEY=
# ASAAS_PLATAFORMA_AMBIENTE=sandbox
# ASAAS_PLATAFORMA_WEBHOOK_TOKEN=

# --- Conta-mãe BaaS (subcontas digitais por laboratório) ---
# Chave da conta raiz com White Label/BaaS. Use aspas simples — a chave começa com $
# ASAAS_CONTA_MAE_API_KEY='$aact_...'
# ASAAS_CONTA_MAE_AMBIENTE=producao
# ASAAS_CONTA_MAE_WEBHOOK_TOKEN=token_secreto_webhook
SUPPORT_WHATSAPP=

# --- E-mail transacional (Resend) — recuperação de senha ---
# Guia: deploy/RESEND-EMAIL.md
RESEND_API_KEY=
EMAIL_FROM="Lab Protese <noreply@denteartlab.com.br>"
EMAIL_REPLY_TO=denteartlab@gmail.com

# --- WhatsApp automático (Baileys) — processo PM2 lab-protese-whatsapp ---
# Gere um token: openssl rand -hex 24
WHATSAPP_HTTP_URL=http://127.0.0.1:3100/send
WHATSAPP_HTTP_TOKEN=
WHATSAPP_BAILEYS_PORT=3100
# URL do app Next.js (porta 3000) — NÃO use a porta 3100 do Baileys
WHATSAPP_WEBHOOK_URL=http://127.0.0.1:3000/api/whatsapp/webhook
# WHATSAPP_AUTH_DIR=/opt/lab-protese-saas/data/whatsapp-auth

# --- Validação pós-deploy (opcional) ---
# VPS_CHECK_URL=http://127.0.0.1:3000

# --- Cloudflare Free (proxy na frente da VPS) ---
# Guia: deploy/CLOUDFLARE-FREE.md
# Na VPS após DNS com nuvem laranja:
#   bash deploy/configurar-cloudflare-free.sh
# CLOUDFLARE_DOMAIN=denteartlab.com.br
# CLOUDFLARE_ORIGIN_CA_KEY=   # só para gerar-cert-cloudflare-via-api.sh

# --- Limpeza de contas inativas (30 dias sem acesso e sem assinatura paga) ---
# O server.ts agenda diariamente (~04:15). Para desativar: LIMPEZA_INATIVOS_ENABLED=0
# Simular: npm run limpar:contas-inativas -- --simular
# Cron alternativo: 15 4 * * * cd /opt/lab-protese-saas && npm run limpar:contas-inativas

# Rate limit compartilhado (login / cadastro / recuperar senha / MFA).
# PRODUÇÃO: Redis obrigatório — sem REDIS_URL o login responde 503.
# Instalar: sudo apt install redis-server && sudo systemctl enable --now redis-server
# Emergência apenas: RATE_LIMIT_ALLOW_MEMORY=1
REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_ALLOW_MEMORY=0

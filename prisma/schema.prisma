generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String
  role            String    @default("usuario")
  colaboradorId   String?
  colaboradorNome String?
  moduloProducao  Boolean   @default(false)
  permissoesJson  String?
  excluidoEm      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}

model Cliente {
  id                  String     @id @default(cuid())
  nome                String
  razaoSocial         String?
  cnpjCpf             String?
  asaasCustomerId     String?
  cro                 String?
  telefone            String?
  celular             String?
  email               String?
  endereco            String?
  cidade              String?
  uf                  String?
  cep                 String?
  observacoes         String?
  tokenAcompanhamento String?    @unique
  ativo               Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  pacientes           Paciente[]
  trabalhos           Trabalho[]
  lancamentos         Lancamento[]
  nfseEmissoes        NfseEmissao[]
}

model Paciente {
  id          String     @id @default(cuid())
  nome        String
  cpf         String?
  telefone    String?
  nascimento  DateTime?
  observacoes String?
  clienteId   String
  cliente     Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  trabalhos   Trabalho[]
}

model Trabalho {
  id                  String   @id @default(cuid())
  numeroOs            Int
  segmentoFaturamento String   @default("servico")
  grupoOsId           String?
  clienteId           String
  pacienteId          String
  cliente             Cliente  @relation(fields: [clienteId], references: [id])
  paciente            Paciente @relation(fields: [pacienteId], references: [id])
  tipoProtese         String
  dentes              String?
  cor                 String?
  material            String?
  escala              String?
  dataEntrada         DateTime @default(now())
  dataPrevista        DateTime?
  dataEntrega         DateTime?
  valor               Float    @default(0)
  status              String   @default("recebido")
  observacoes         String?
  instrucoes          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lancamentos         Lancamento[]

  /** Vários serviços na mesma OS: unicidade por número + segmento + título do serviço. */
  @@unique([numeroOs, segmentoFaturamento, tipoProtese])
  @@index([numeroOs])
  @@index([grupoOsId])
}

model Produto {
  id          String   @id @default(cuid())
  nome        String
  categoria   String?
  valor       Float    @default(0)
  ativo       Boolean  @default(true)
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lancamento {
  id             String    @id @default(cuid())
  tipo           String
  descricao      String
  valor          Float
  data           DateTime  @default(now())
  status         String    @default("pendente")
  formaPagamento String?
  clienteId      String?
  cliente        Cliente?  @relation(fields: [clienteId], references: [id])
  trabalhoId     String?
  trabalho       Trabalho? @relation(fields: [trabalhoId], references: [id])
  cobrancaAsaas  CobrancaAsaas?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model NfseEmissao {
  id                String   @id @default(cuid())
  clienteId         String?
  cliente           Cliente? @relation(fields: [clienteId], references: [id])
  lancamentoId      String?
  valor             Float
  descricao         String
  status            String   @default("processando")
  providerId        String?
  numeroNfse        String?
  codigoVerificacao String?
  pdfUrl            String?
  mensagemErro      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CobrancaAsaas {
  id             String     @id @default(cuid())
  lancamentoId   String     @unique
  lancamento     Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  asaasPaymentId String     @unique
  bankSlipUrl    String?
  invoiceUrl     String?
  linhaDigitavel String?
  statusAsaas    String     @default("PENDING")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model SequenciaNumerica {
  chave String @id
  valor Int    @default(0)
}

model JsonStore {
  key       String   @id
  payload   String
  updatedAt DateTime @updatedAt
}

model LogAuditoria {
  id            String   @id @default(cuid())
  categoria     String
  tipoAlteracao String
  numeroOs      Int?
  trabalhoId    String?
  lancamentoId  String?
  referencia    String?
  servico       String?
  etapa         String?
  colaborador   String?
  clienteNome   String?
  parcelaNumero Int?
  parcelaTotal  Int?
  usuarioId     String?
  usuarioNome   String
  dataAlteracao DateTime @default(now())
  detalhesJson  String?

  @@index([categoria])
  @@index([tipoAlteracao])
  @@index([numeroOs])
  @@index([referencia])
  @@index([lancamentoId])
  @@index([dataAlteracao])
}

model Orcamento {
  id                 String    @id @default(cuid())
  numeroPedido       Int       @unique
  token              String    @unique
  data               DateTime  @default(now())
  dataResposta       DateTime?
  fornecedorId       String?
  fornecedorNome     String    @default("")
  status             String    @default("pendente")
  subtotal           Float     @default(0)
  desconto           Float     @default(0)
  descontoPercentual Float     @default(0)
  totalLiquido       Float     @default(0)
  observacoes        String?
  condicoesPagamento String?
  respostaFornecedor String?
  emailEnvio         String?
  whatsappEnvio      String?
  labNome            String
  labTelefone        String?
  labEmail           String?
  itensJson          String
  linkAtivo          Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/** Anexos (despesas, receitas, OS) — persistidos no banco em produção (Vercel). */
model ArquivoUpload {
  id        String   @id @default(cuid())
  pasta     String
  nome      String
  mimeType  String   @default("application/octet-stream")
  tamanho   Int
  dados     Bytes
  criadoEm  DateTime @default(now())

  @@index([pasta])
}

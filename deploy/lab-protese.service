# Systemd — /etc/systemd/system/lab-protese.service
# systemctl daemon-reload && systemctl enable lab-protese && systemctl restart lab-protese
#
# Ajuste WorkingDirectory e EnvironmentFile para o caminho real no VPS.

[Unit]
Description=Lab Prótese (Next.js + Socket.IO TV, multi-empresa)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lab-protese-saas
EnvironmentFile=/opt/lab-protese-saas/.env
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

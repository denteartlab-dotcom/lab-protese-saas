# Banco da plataforma (usuários e laboratórios). Dados de cada lab ficam em prisma/tenants/{id}.db
DATABASE_URL="file:./prisma/platform.db"
JWT_SECRET="change-me-in-production"
# Produção (Vercel): anexos vão para o PostgreSQL automaticamente.
# Local: grava em public/uploads. Forçar banco: UPLOAD_STORAGE=database
NEXT_PUBLIC_APP_NAME="Lab Prótese"
# URL pública do app (links clicáveis no WhatsApp). Ex.: https://smartprotese.app
NEXT_PUBLIC_APP_URL=""
# Open Finance (Pluggy) — conexão com internet banking no cadastro de conta bancária
# Crie conta em https://pluggy.ai e use credenciais de sandbox para testes
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# Verificação de cadastro por WhatsApp
# Modo dev: em development, exibe o código na tela se não houver API configurada
WHATSAPP_DEV_MODE=""
# Meta WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Nome do template aprovado (corpo com variável {{1}} = código de 6 dígitos)
WHATSAPP_OTP_TEMPLATE="otp_verificacao"
# Ou API HTTP genérica (Evolution, Z-API, etc.): POST { phone, message, codigo }
WHATSAPP_HTTP_URL=""
WHATSAPP_HTTP_TOKEN=""

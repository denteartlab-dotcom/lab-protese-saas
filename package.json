{
  "name": "lab-protese-saas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/limpar-cache-webpack.mjs && node scripts/next-dev.mjs",
    "dev:server": "node --max-old-space-size=8192 scripts/run-server.mjs",
    "dev:tsx": "node --max-old-space-size=8192 node_modules/tsx/dist/cli.mjs server.ts",
    "dev:next": "node scripts/limpar-cache-webpack.mjs && node scripts/next-dev.mjs",
    "dev:limpo": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && node scripts/next-dev.mjs",
    "build": "prisma generate && node --max-old-space-size=4096 node_modules/next/dist/bin/next build && node scripts/bundle-server.mjs",
    "start": "node scripts/run-server.mjs",
    "start:next": "next start -p 3000",
    "pm2:start": "pm2 start deploy/ecosystem.config.cjs",
    "pm2:restart": "pm2 restart lab-protese lab-protese-whatsapp",
    "whatsapp:baileys": "node scripts/whatsapp-baileys-server.mjs",
    "whatsapp:diagnostico": "node scripts/whatsapp-diagnostico.mjs",
    "whatsapp:reset": "node scripts/whatsapp-reset.mjs",
    "whatsapp:test-envio": "node scripts/whatsapp-test-envio.mjs",
    "whatsapp:test-chatbot": "node scripts/whatsapp-test-chatbot.mjs",
    "whatsapp:pausar": "node scripts/whatsapp-pausar.mjs",
    "whatsapp:liberar": "node scripts/whatsapp-liberar.mjs",
    "pm2:beta": "pm2 start deploy/ecosystem-beta.config.cjs",
    "pm2:beta:restart": "pm2 restart lab-protese-beta",
    "lint": "next lint",
    "metrics:api": "node scripts/metrics-api.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "setup": "prisma generate && prisma db push && node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:push": "prisma db push",
    "db:preparar-legado": "node node_modules/tsx/dist/cli.mjs scripts/preparar-banco-legado-vps.ts",
    "db:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:criar-master": "node node_modules/tsx/dist/cli.mjs scripts/criar-master.ts",
    "db:migrar-empresa": "node node_modules/tsx/dist/cli.mjs scripts/migrar-empresa-fase1.ts && node node_modules/tsx/dist/cli.mjs scripts/migrar-empresa-fase5.ts",
    "db:migrar-empresa-fase5": "node node_modules/tsx/dist/cli.mjs scripts/migrar-empresa-fase5.ts",
    "db:testar-isolamento": "node node_modules/tsx/dist/cli.mjs scripts/testar-isolamento-tenant.ts",
    "db:rls": "prisma db execute --file prisma/sql/enable-rls-tenant.sql --schema prisma/schema.prisma",
    "db:rls-force": "prisma db execute --file prisma/sql/force-rls-app.sql --schema prisma/schema.prisma",
    "db:rls-noforce": "prisma db execute --file prisma/sql/disable-force-rls.sql --schema prisma/schema.prisma",
    "db:role-app": "node scripts/create-app-role.mjs",
    "db:grant-app": "prisma db execute --file prisma/sql/grant-lab-app-tables.sql --schema prisma/schema.prisma",
    "db:testar-rls": "node node_modules/tsx/dist/cli.mjs scripts/testar-rls-tenant.ts",
    "db:reparar-usuarios-empresa": "node node_modules/tsx/dist/cli.mjs scripts/reparar-usuarios-empresa.ts",
    "vps:validar": "node node_modules/tsx/dist/cli.mjs scripts/migrar-empresa-fase6.ts",
    "vps:deploy": "bash deploy/atualizar-producao.sh",
    "vps:cloudflare": "bash deploy/configurar-cloudflare-free.sh",
    "db:publicar-neon": "node node_modules/tsx/dist/cli.mjs scripts/publicar-banco-neon.ts",
    "db:migrar-financeiro": "node node_modules/tsx/dist/cli.mjs scripts/migrar-financeiro-neon.ts",
    "backup:diario": "node node_modules/tsx/dist/cli.mjs scripts/backup-diario.ts",
    "uploads:migrar-onedrive": "node node_modules/tsx/dist/cli.mjs scripts/migrar-uploads-onedrive.ts",
    "uploads:testar-onedrive": "node node_modules/tsx/dist/cli.mjs scripts/testar-onedrive-upload.ts",
    "uploads:onedrive-token": "node node_modules/tsx/dist/cli.mjs scripts/obter-refresh-token-onedrive.ts",
    "limpar:contas-inativas": "node node_modules/tsx/dist/cli.mjs scripts/limpar-contas-inativas.ts",
    "email:testar-inatividade": "node node_modules/tsx/dist/cli.mjs scripts/testar-email-aviso-inatividade.ts",
    "db:zerar": "node node_modules/tsx/dist/cli.mjs scripts/zerar-sistema-virgem.ts --confirmar=ZERAR",
    "uploads:migrar-privados": "node scripts/migrar-uploads-privados.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.6.0",
    "@tanstack/react-query": "^5.101.0",
    "@whiskeysockets/baileys": "^6.7.23",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.40.0",
    "googleapis": "^173.0.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.11.1",
    "jose": "^6.0.10",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "otpauth": "^9.5.1",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.14.0",
    "prisma": "^6.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.78.0",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.0",
    "tsx": "^4.19.4",
    "unzipper": "^0.12.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/unzipper": "^0.10.11",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^11.10.0",
    "esbuild": "^0.25.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}

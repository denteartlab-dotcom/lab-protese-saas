# Banco PostgreSQL (Neon em produção). Local: pode usar SQLite em prisma/platform.db e publicar com npm run db:publicar-neon
# VPS Linux local (multi-empresa): use deploy/env.vps.example como base
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="change-me-in-production"
# Bootstrap HTTP /api/setup/* — em produção exige ambos; em dev fica liberado
# ALLOW_SETUP=true
# SETUP_SECRET="gere-um-segredo-forte"
# Painel Master (/admin-master) — proprietário da plataforma
MASTER_ADMIN_EMAIL="admin@labprotese.com"
# Dev local: 0 = não roda backup ao iniciar npm run dev (mais rápido). Produção: 1
BACKUP_AUTOMATICO_ENABLED=0
# Limpeza de contas inativas (aviso 3 dias antes + exclusão após 30 dias sem acesso/assinatura). 0 = desliga
# LIMPEZA_INATIVOS_ENABLED=1
# WhatsApp do suporte (barra de assinatura no rodapé)
SUPPORT_WHATSAPP=
# Renovação de assinatura via PIX — Mercado Pago (recomendado) ou Asaas
# Guia VPS: deploy/MERCADOPAGO-ASSINATURA.md
# Mercado Pago: https://www.mercadopago.com.br/developers/panel/app — credenciais de teste ou produção
MP_PLATAFORMA_ACCESS_TOKEN=
MP_PLATAFORMA_AMBIENTE=sandbox
# Secret gerado ao cadastrar webhook (evento Pagamentos) no painel MP
MP_PLATAFORMA_WEBHOOK_SECRET=
# Asaas (alternativa — usado só se MP não estiver configurado)
ASAAS_PLATAFORMA_API_KEY=
ASAAS_PLATAFORMA_AMBIENTE=sandbox
ASAAS_PLATAFORMA_WEBHOOK_TOKEN=
# Conta-mãe BaaS — cria subcontas digitais para cada laboratório (Smart Prótese)
# Use a chave da conta raiz com White Label/BaaS habilitado pelo gerente Asaas
ASAAS_CONTA_MAE_API_KEY=
ASAAS_CONTA_MAE_AMBIENTE=sandbox
ASAAS_CONTA_MAE_WEBHOOK_TOKEN=
# VPS sem HTTPS (acesso por IP): COOKIE_SECURE=false — remova quando usar domínio com SSL
# COOKIE_SECURE=false
# VPS Linux: HOSTNAME=0.0.0.0 PORT=3000 NODE_ENV=production
# Migração multi-empresa: npm run db:migrar-empresa && npm run vps:validar
# EMPRESA_SLUG_PADRAO=denteart
# EMPRESA_NOME_PADRAO=DenteArt
# BACKUP_AUTOMATICO_PATH=/var/backups/lab-protese
# Réplica Google Drive (VPS): deploy/env.vps.example — GOOGLE_DRIVE_BACKUP_ENABLED, GOOGLE_DRIVE_FOLDER_ID, credenciais
# Produção (Vercel): anexos vão para o PostgreSQL automaticamente.
# Local: grava em var/uploads. Forçar banco: UPLOAD_STORAGE=database
# Nuvem OneDrive direto (VPS + Microsoft Graph): UPLOAD_STORAGE=onedrive
# Ver deploy/ONEDRIVE-UPLOADS.md (CLIENT_ID, SECRET, REFRESH_TOKEN)
NEXT_PUBLIC_APP_NAME="Lab Prótese"
# URL pública do app (WhatsApp, acompanhamento, orçamentos).
# Local: omita ou use http://localhost:3000 — em dev sem variável, o app usa localhost automaticamente.
# Produção: https://www.denteartlab.com.br
# URL_PUBLICA_DO_APP="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
URL_PUBLICA_DO_APP="https://www.denteartlab.com.br"
NEXT_PUBLIC_APP_URL="https://www.denteartlab.com.br"
# Open Finance (Pluggy) — conexão com internet banking no cadastro de conta bancária
# Crie conta em https://pluggy.ai e use credenciais de sandbox para testes
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# Mensagens de aniversário no dashboard (IA).
# Recomendado (grátis): Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Opcional (pago): OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Sem nenhuma chave: usa textos locais variados (também grátis).
# Verificação de cadastro por WhatsApp
# Modo dev: em development, exibe o código na tela se não houver API configurada
WHATSAPP_DEV_MODE=""
# --- Chatbot API oficial Meta (recomendado — grátis quando o cliente manda primeiro) ---
# Guia: developers.facebook.com → seu App → WhatsApp → API Setup
WHATSAPP_CHATBOT_PROVIDER=cloud
WHATSAPP_CHATBOT_ENABLED=true
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Você inventa este valor; o mesmo vai no painel Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=""
# App Dashboard → Configurações → Básico → Chave secreta do aplicativo
WHATSAPP_APP_SECRET=""
# ID do laboratório no banco (cuid). Na VPS com 1 lab pode omitir.
# WHATSAPP_EMPRESA_ID=clxxxxxxxxxxxxxxxx
# Nome do template aprovado (corpo com variável {{1}} = código de 6 dígitos)
WHATSAPP_OTP_TEMPLATE="otp_verificacao"
# --- Baileys (disparos opcionais — não necessário para chatbot Cloud) ---
# WHATSAPP_HTTP_URL="http://127.0.0.1:3100/send"
WHATSAPP_HTTP_TOKEN=""

# Rate limit compartilhado (login / cadastro / recuperar senha).
# Com Redis: contagem vale entre reinícios e múltiplas instâncias PM2.
# Sem Redis ou se Redis estiver offline: fallback automático em memória.
REDIS_URL=redis://127.0.0.1:6379

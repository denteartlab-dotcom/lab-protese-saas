generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/tenant-client"
}

datasource db {
  provider = "sqlite"
  url      = env("TENANT_DATABASE_URL")
}

model Cliente {
  id                  String     @id @default(cuid())
  nome                String
  razaoSocial         String?
  cnpjCpf             String?
  cro                 String?
  telefone            String?
  celular             String?
  email               String?
  endereco            String?
  cidade              String?
  uf                  String?
  cep                 String?
  observacoes         String?
  tokenAcompanhamento String?    @unique
  ativo               Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  pacientes           Paciente[]
  trabalhos           Trabalho[]
  lancamentos         Lancamento[]
}

model Paciente {
  id          String     @id @default(cuid())
  nome        String
  cpf         String?
  telefone    String?
  nascimento  DateTime?
  observacoes String?
  clienteId   String
  cliente     Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  trabalhos   Trabalho[]
}

model Trabalho {
  id                    String   @id @default(cuid())
  numeroOs              Int
  segmentoFaturamento    String   @default("servico")
  grupoOsId             String?
  clienteId             String
  pacienteId            String
  cliente               Cliente  @relation(fields: [clienteId], references: [id])
  paciente              Paciente @relation(fields: [pacienteId], references: [id])
  tipoProtese           String
  dentes                String?
  cor                   String?
  material              String?
  escala                String?
  dataEntrada           DateTime @default(now())
  dataPrevista          DateTime?
  dataEntrega           DateTime?
  valor                 Float    @default(0)
  status                String   @default("recebido")
  observacoes           String?
  instrucoes            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lancamentos           Lancamento[]

  @@unique([numeroOs, segmentoFaturamento])
  @@index([numeroOs])
  @@index([grupoOsId])
}

model Produto {
  id          String   @id @default(cuid())
  nome        String
  categoria   String?
  valor       Float    @default(0)
  ativo       Boolean  @default(true)
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lancamento {
  id             String    @id @default(cuid())
  tipo           String
  descricao      String
  valor          Float
  data           DateTime  @default(now())
  status         String    @default("pendente")
  formaPagamento String?
  clienteId      String?
  cliente        Cliente?  @relation(fields: [clienteId], references: [id])
  trabalhoId     String?
  trabalho       Trabalho? @relation(fields: [trabalhoId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model SequenciaNumerica {
  chave String @id
  valor Int    @default(0)
}

model JsonStore {
  key       String   @id
  payload   String
  updatedAt DateTime @updatedAt
}

model Orcamento {
  id                 String    @id @default(cuid())
  numeroPedido       Int       @unique
  token              String    @unique
  data               DateTime  @default(now())
  dataResposta       DateTime?
  fornecedorId       String?
  fornecedorNome     String    @default("")
  status             String    @default("pendente")
  subtotal           Float     @default(0)
  desconto           Float     @default(0)
  descontoPercentual Float     @default(0)
  totalLiquido       Float     @default(0)
  observacoes        String?
  condicoesPagamento String?
  respostaFornecedor String?
  emailEnvio         String?
  whatsappEnvio      String?
  labNome            String
  labTelefone        String?
  labEmail           String?
  itensJson          String
  linkAtivo          Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

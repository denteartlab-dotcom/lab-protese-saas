generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Empresa {
  id        String   @id @default(cuid())
  codigo    String?  @unique
  nome      String
  slug      String   @unique
  responsavel     String?
  cnpj            String?
  telefone        String?
  whatsapp        String?
  email           String?
  cidade          String?
  estado          String?
  plano           String   @default("basico")
  limiteUsuarios  Int      @default(5)
  limiteTrabalhos Int      @default(500)
  dataVencimento  DateTime?
  observacoes     String?
  status    String   @default("ativo")
  asaasCustomerIdPlataforma String?
  ultimoAcessoEm DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  clientes   Cliente[]
  trabalhos  Trabalho[]
  produtos   Produto[]
  lancamentos Lancamento[]
  orcamentos Orcamento[]
  contas     ContaBancaria[]
  uploads    ArquivoUpload[]
  sequencias SequenciaNumerica[]
  logsAuditoria  LogAuditoria[]
  historicoEtapas HistoricoEtapa[]
  nfseEmissoes   NfseEmissao[]
  cobrancasAssinatura CobrancaAssinatura[]
  asaasSubconta       AsaasSubconta?
  suporteConversa     SuporteConversa?
}

model SuporteConversa {
  id               String   @id @default(cuid())
  empresaId        String   @unique
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ultimaMensagemEm DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mensagens SuporteMensagem[]

  @@index([ultimaMensagemEm])
  @@map("suporte_conversas")
}

model SuporteMensagem {
  id                String          @id @default(cuid())
  conversaId        String
  conversa          SuporteConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  remetenteTipo     String
  remetenteUserId   String?
  remetenteMasterId String?
  remetenteNome     String
  texto             String
  lidaEm            DateTime?
  createdAt         DateTime        @default(now())

  @@index([conversaId, createdAt])
  @@index([conversaId, remetenteTipo, lidaEm])
  @@map("suporte_mensagens")
}

model AsaasSubconta {
  id               String   @id @default(cuid())
  empresaId        String   @unique
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  asaasAccountId   String?  @unique
  walletId         String?
  apiKey           String?
  status           String   @default("nao_iniciado")
  statusGeral      String?
  statusDocumentacao String?
  agencia          String?
  conta            String?
  contaDigito      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

model User {
  id              String    @id @default(cuid())
  empresaId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  name            String
  email           String
  password        String
  role            String    @default("usuario")
  colaboradorId   String?
  colaboradorNome String?
  moduloProducao  Boolean   @default(false)
  permissoesJson  String?
  excluidoEm      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  tokensRecuperacaoSenha PasswordResetToken[]

  @@unique([empresaId, email])
  @@index([empresaId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CadastroVerificacaoEmail {
  id         String    @id @default(cuid())
  email      String
  codigoHash String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Cliente {
  id                  String     @id @default(cuid())
  empresaId           String
  empresa             Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome                String
  razaoSocial         String?
  cnpjCpf             String?
  asaasCustomerId     String?
  cro                 String?
  telefone            String?
  celular             String?
  email               String?
  endereco            String?
  cidade              String?
  uf                  String?
  cep                 String?
  observacoes         String?
  representanteColaboradorId String?
  tokenAcompanhamento String?    @unique
  ativo               Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  pacientes           Paciente[]
  trabalhos           Trabalho[]
  lancamentos         Lancamento[]
  nfseEmissoes        NfseEmissao[]

  @@index([empresaId])
}

model Paciente {
  id          String     @id @default(cuid())
  nome        String
  cpf         String?
  telefone    String?
  nascimento  DateTime?
  observacoes String?
  clienteId   String
  cliente     Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  trabalhos   Trabalho[]
}

model Trabalho {
  id                  String   @id @default(cuid())
  empresaId           String
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numeroOs            Int
  segmentoFaturamento String   @default("servico")
  grupoOsId           String?
  clienteId           String
  pacienteId          String
  cliente             Cliente  @relation(fields: [clienteId], references: [id])
  paciente            Paciente @relation(fields: [pacienteId], references: [id])
  tipoProtese         String
  dentes              String?
  cor                 String?
  material            String?
  escala              String?
  dataEntrada         DateTime @default(now())
  dataPrevista        DateTime?
  dataEntrega         DateTime?
  valor               Float    @default(0)
  status              String   @default("recebido")
  observacoes         String?
  instrucoes          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lancamentos         Lancamento[]

  /** Vários serviços na mesma OS: unicidade por número + segmento + título do serviço. */
  @@unique([empresaId, numeroOs, segmentoFaturamento, tipoProtese])
  @@index([numeroOs])
  @@index([grupoOsId])
  @@index([empresaId])
}

model Produto {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome        String
  categoria   String?
  valor       Float    @default(0)
  ativo       Boolean  @default(true)
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([empresaId])
}

model Lancamento {
  id             String    @id @default(cuid())
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo           String
  descricao      String
  valor          Float
  data           DateTime  @default(now())
  status         String    @default("pendente")
  formaPagamento String?
  clienteId      String?
  cliente        Cliente?  @relation(fields: [clienteId], references: [id])
  trabalhoId     String?
  trabalho       Trabalho? @relation(fields: [trabalhoId], references: [id])
  cobrancaAsaas  CobrancaAsaas?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([empresaId])
  @@index([tipo])
  @@index([data])
}

model NfseEmissao {
  id                String   @id @default(cuid())
  empresaId         String?
  empresa           Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteId         String?
  cliente           Cliente? @relation(fields: [clienteId], references: [id])
  lancamentoId      String?
  valor             Float
  descricao         String
  status            String   @default("processando")
  providerId        String?
  numeroNfse        String?
  codigoVerificacao String?
  pdfUrl            String?
  mensagemErro      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([empresaId])
}

model CobrancaAsaas {
  id             String     @id @default(cuid())
  lancamentoId   String     @unique
  lancamento     Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  asaasPaymentId String     @unique
  bankSlipUrl    String?
  invoiceUrl     String?
  linhaDigitavel String?
  statusAsaas    String     @default("PENDING")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model SequenciaNumerica {
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  chave     String
  valor     Int     @default(0)

  @@id([empresaId, chave])
}

model JsonStore {
  key       String   @id
  payload   String
  updatedAt DateTime @updatedAt
}

model LogAuditoria {
  id            String   @id @default(cuid())
  empresaId     String?
  empresa       Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria     String
  tipoAlteracao String
  numeroOs      Int?
  trabalhoId    String?
  lancamentoId  String?
  referencia    String?
  servico       String?
  etapa         String?
  colaborador   String?
  clienteNome   String?
  parcelaNumero Int?
  parcelaTotal  Int?
  usuarioId     String?
  usuarioNome   String
  dataAlteracao DateTime @default(now())
  detalhesJson  String?

  @@index([empresaId])
  @@index([categoria])
  @@index([tipoAlteracao])
  @@index([numeroOs])
  @@index([referencia])
  @@index([lancamentoId])
  @@index([dataAlteracao])
}

/** Histórico de passagem por etapas de produção (retrabalho / repetição). */
model HistoricoEtapa {
  id              String    @id @default(cuid())
  empresaId       String?
  empresa         Empresa?  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  trabalhoId      String
  numeroOs        Int
  clienteId       String
  etapa           String
  colaboradorId   String?
  colaboradorNome String?
  dataEntrada     DateTime  @default(now())
  dataSaida       DateTime?
  observacao      String?
  motivoRetorno   String?
  itemId          String?
  tipoRepeticao   String?
  valorPrejuizo   Float     @default(0)
  descricaoItem   String?

  @@index([empresaId])
  @@index([trabalhoId])
  @@index([clienteId])
  @@index([numeroOs])
  @@index([etapa])
  @@index([dataEntrada])
  @@map("historico_etapas")
}

model Orcamento {
  id                 String    @id @default(cuid())
  empresaId          String
  empresa            Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numeroPedido       Int
  token              String    @unique
  data               DateTime  @default(now())
  dataResposta       DateTime?
  fornecedorId       String?
  fornecedorNome     String    @default("")
  status             String    @default("pendente")
  subtotal           Float     @default(0)
  desconto           Float     @default(0)
  descontoPercentual Float     @default(0)
  totalLiquido       Float     @default(0)
  observacoes        String?
  condicoesPagamento String?
  respostaFornecedor String?
  emailEnvio         String?
  whatsappEnvio      String?
  labNome            String
  labTelefone        String?
  labEmail           String?
  itensJson          String
  linkAtivo          Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([empresaId, numeroPedido])
  @@index([empresaId])
}

/** Anexos (despesas, receitas, OS) — persistidos no banco em produção (Vercel). */
model ArquivoUpload {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pasta     String
  nome      String
  mimeType  String   @default("application/octet-stream")
  tamanho   Int
  dados     Bytes
  criadoEm  DateTime @default(now())

  @@index([empresaId])
  @@index([pasta])
}

/** Contas bancárias persistidas no PostgreSQL (substitui JsonStore para não perder dados). */
model ContaBancaria {
  id              String                @id
  empresaId       String
  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome            String
  saldoInicial    Float                 @default(0)
  excluida        Boolean               @default(false)
  acaoPrincipal   String                @default("movimentar")
  codBanco        String                @default("")
  agencia         String                @default("")
  numeroConta     String                @default("")
  tipoChavePix    String                @default("")
  chavePix        String                @default("")
  modoVinculo     String                @default("manual")
  openFinanceJson String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  movimentacoes   MovimentacaoConta[]
  extrato         ExtratoMovimentacao[]

  @@index([empresaId])
  @@index([codBanco, agencia, numeroConta])
}

model MovimentacaoConta {
  id        String        @id
  contaId   String
  conta     ContaBancaria @relation(fields: [contaId], references: [id], onDelete: Cascade)
  tipo      String
  valor     Float
  descricao String
  data      DateTime
  createdAt DateTime      @default(now())

  @@index([contaId])
}

model ExtratoMovimentacao {
  id        String        @id
  contaId   String
  conta     ContaBancaria @relation(fields: [contaId], references: [id], onDelete: Cascade)
  tipo      String
  valor     Float
  descricao String
  data      DateTime
  origem    String
  idExterno String?
  createdAt DateTime      @default(now())

  @@unique([contaId, idExterno])
  @@index([contaId])
}

model MasterUser {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  role      String   @default("MASTER_ADMIN")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs MasterAuditLog[]

  @@map("master_users")
}

model MasterAuditLog {
  id        String     @id @default(cuid())
  masterId  String
  master    MasterUser @relation(fields: [masterId], references: [id], onDelete: Cascade)
  acao      String
  detalhes  String?
  empresaId String?
  ip        String?
  createdAt DateTime   @default(now())

  @@index([masterId])
  @@index([empresaId])
  @@index([createdAt])
  @@map("master_audit_logs")
}

model CobrancaAssinatura {
  id             String    @id @default(cuid())
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  asaasPaymentId String    @unique
  provedor       String    @default("asaas")
  plano          String
  valor          Float
  diasRenovacao  Int       @default(30)
  statusAsaas    String    @default("PENDING")
  pixPayload     String?
  pixExpiraEm    DateTime?
  pagoEm         DateTime?
  renovadoEm     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([empresaId])
  @@index([statusAsaas])
  @@map("cobrancas_assinatura")
}
